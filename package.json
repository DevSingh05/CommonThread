{
  "name": "commonthread",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.14.0 <25" },
  "scripts": {
    "dev": "npm run dev:server",
    "dev:server": "node --env-file-if-exists=.env --import tsx --watch src/server/main.ts",
    "start": "node --env-file-if-exists=.env dist/server/server/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc -p tsconfig.build.json",
    "demo": "tsx scripts/demo.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": { "zod": "4.6.6" },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "tsx": "4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
