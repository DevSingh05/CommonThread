{
  "name": "commonthread",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "dev:web": "vite",
    "build:web": "vite build",
    "preview:web": "vite preview",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "lint:web": "eslint src/web test/web vite.config.ts vitest.web.config.ts playwright.config.ts",
    "test:web": "vitest run --config vitest.web.config.ts",
    "test:browser": "playwright test",
    "mock-engine": "node --experimental-strip-types test/web/mock-engine/main.ts",
    "check:web": "npm run typecheck:web && npm run lint:web && npm run test:web && npm run build:web",
    "dev": "npm run dev:server",
    "dev:server": "node --env-file-if-exists=.env --import tsx --watch src/server/main.ts",
    "start": "node --env-file-if-exists=.env dist/server/server/main.js",
    "typecheck": "npm run typecheck:server && npm run typecheck:web",
    "lint": "eslint .",
    "test": "npm run test:server && npm run test:web",
    "test:watch": "vitest --config vitest.config.ts",
    "build": "npm run build:server && npm run build:web",
    "demo": "tsx scripts/demo.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "smoke:providers": "tsx scripts/provider-smoke.ts",
    "typecheck:server": "tsc --noEmit",
    "test:server": "vitest run --config vitest.config.ts",
    "build:server": "tsc -p tsconfig.build.json",
    "test:integration": "playwright test --config playwright.integration.config.ts"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "zod": "4.6.6",
    "@anthropic-ai/claude-agent-sdk": "0.3.296",
    "@openai/codex-sdk": "0.162.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "^8.3.4",
    "vitest": "5.0.3",
    "tsx": "4.23.15"
  }
}
