# Node 24.14+; demo requires no credentials. The server never loads provider secrets into browsers.
COMMONTHREAD_PORT=4317
COMMONTHREAD_DATA_DIR=.commonthread
COMMONTHREAD_TURN_TIMEOUT_MS=120000
# Only when developing the UI through a Vite /api proxy. No wildcard CORS is enabled.
# COMMONTHREAD_DEV_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Live adapters and repository safeguards must be registered by their owning branches.
