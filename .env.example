# Node 24.14+; demo requires no credentials. The server never loads provider secrets into browsers.
COMMONTHREAD_PORT=4317
COMMONTHREAD_DATA_DIR=.commonthread
COMMONTHREAD_TURN_TIMEOUT_MS=120000
# Live adapters and repository safeguards must be registered by their owning branches.

# --- Provider adapters (feature/provider-adapters) ---
# Live providers stay disabled unless explicitly enabled. Default policy is read-only, no shell, no network.
COMMONTHREAD_LIVE=0
# Optional model overrides; omit to use each CLI's default model.
COMMONTHREAD_CLAUDE_MODEL=
COMMONTHREAD_CODEX_MODEL=
# Optional Claude SDK caps (maxBudgetUsd is an SDK estimate, not a billing statement).
COMMONTHREAD_CLAUDE_MAX_BUDGET_USD=
COMMONTHREAD_CLAUDE_MAX_TURNS=
# Credentials: prefer `claude` login and `codex login`. If you must use keys, set them in your shell or .env (never commit):
# ANTHROPIC_API_KEY=
# CODEX_API_KEY=
